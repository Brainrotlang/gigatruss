gigachad gt_abs(gigachad x) {
    edgy (x < 0.0) {
        bussin -x;
    }
    bussin x;
}

gigachad gt_sqrt(gigachad x) {
    edgy (x <= 0.0) {
        bussin 0.0;
    }

    gigachad guess = x;
    edgy (guess < 1.0) {
        guess = 1.0;
    }

    flex (rizz i = 0; i < 32; i = i + 1) {
        guess = 0.5 * (guess + x / guess);
    }

    bussin guess;
}

skibidi main {
    🚽 Gigatruss v0.1: canonical 3-node triangular truss.
    🚽 Units: metres, newtons, pascals.

    rizz node_count = 3;
    rizz member_count = 3;
    rizz dof_count = 6;

    gigachad node_x[3];
    gigachad node_y[3];
    rizz member_a[3];
    rizz member_b[3];
    gigachad member_E[3];
    gigachad member_A[3];

    gigachad K[36];
    gigachad K_original[36];
    gigachad F[6];
    gigachad F_original[6];
    gigachad U[6];
    gigachad R[6];
    cap fixed[6];

    🚽 Geometry.
    node_x[0] = 0.0;
    node_y[0] = 0.0;
    node_x[1] = 4.0;
    node_y[1] = 0.0;
    node_x[2] = 2.0;
    node_y[2] = 3.0;

    member_a[0] = 0;
    member_b[0] = 1;
    member_a[1] = 0;
    member_b[1] = 2;
    member_a[2] = 1;
    member_b[2] = 2;

    flex (rizz m = 0; m < member_count; m = m + 1) {
        member_E[m] = 200.0e9;
        member_A[m] = 0.001;
    }

    🚽 Supports: node 1 fixed X/Y, node 2 fixed Y.
    flex (rizz i = 0; i < dof_count; i = i + 1) {
        fixed[i] = L;
    }
    fixed[0] = W;
    fixed[1] = W;
    fixed[3] = W;

    🚽 External load: node 3, Fy = -10 kN.
    flex (rizz i = 0; i < dof_count; i = i + 1) {
        F[i] = 0.0;
        U[i] = 0.0;
        R[i] = 0.0;
    }
    F[5] = -10000.0;

    🚽 Zero global stiffness matrix.
    flex (rizz i = 0; i < 36; i = i + 1) {
        K[i] = 0.0;
        K_original[i] = 0.0;
    }

    🚽 Assemble each 2D truss element into the 6x6 global matrix.
    flex (rizz m = 0; m < member_count; m = m + 1) {
        rizz a = member_a[m];
        rizz b = member_b[m];

        gigachad dx = node_x[b] - node_x[a];
        gigachad dy = node_y[b] - node_y[a];
        gigachad length = gt_sqrt(dx * dx + dy * dy);
        gigachad c = dx / length;
        gigachad s = dy / length;
        gigachad scale = member_E[m] * member_A[m] / length;

        gigachad ke[16];
        rizz dofs[4];

        ke[0]  = scale * c * c;
        ke[1]  = scale * c * s;
        ke[2]  = -scale * c * c;
        ke[3]  = -scale * c * s;

        ke[4]  = scale * c * s;
        ke[5]  = scale * s * s;
        ke[6]  = -scale * c * s;
        ke[7]  = -scale * s * s;

        ke[8]  = -scale * c * c;
        ke[9]  = -scale * c * s;
        ke[10] = scale * c * c;
        ke[11] = scale * c * s;

        ke[12] = -scale * c * s;
        ke[13] = -scale * s * s;
        ke[14] = scale * c * s;
        ke[15] = scale * s * s;

        dofs[0] = 2 * a;
        dofs[1] = 2 * a + 1;
        dofs[2] = 2 * b;
        dofs[3] = 2 * b + 1;

        flex (rizz i = 0; i < 4; i = i + 1) {
            flex (rizz j = 0; j < 4; j = j + 1) {
                rizz row = dofs[i];
                rizz col = dofs[j];
                K[row * dof_count + col] = K[row * dof_count + col] + ke[i * 4 + j];
            }
        }
    }

    🚽 Preserve the unconstrained system for reaction recovery.
    flex (rizz i = 0; i < 36; i = i + 1) {
        K_original[i] = K[i];
    }
    flex (rizz i = 0; i < dof_count; i = i + 1) {
        F_original[i] = F[i];
    }

    🚽 Apply zero-displacement boundary conditions by row/column elimination.
    flex (rizz d = 0; d < dof_count; d = d + 1) {
        edgy (fixed[d] == W) {
            flex (rizz j = 0; j < dof_count; j = j + 1) {
                K[d * dof_count + j] = 0.0;
                K[j * dof_count + d] = 0.0;
            }
            K[d * dof_count + d] = 1.0;
            F[d] = 0.0;
        }
    }

    🚽 Gaussian elimination with partial pivoting.
    flex (rizz k = 0; k < dof_count; k = k + 1) {
        rizz pivot_row = k;
        gigachad pivot_abs = gt_abs(K[k * dof_count + k]);

        flex (rizz i = k + 1; i < dof_count; i = i + 1) {
            gigachad candidate = gt_abs(K[i * dof_count + k]);
            edgy (candidate > pivot_abs) {
                pivot_abs = candidate;
                pivot_row = i;
            }
        }

        edgy (pivot_abs < 0.000000001) {
            baka("gigatruss: singular stiffness matrix");
            ragequit(2);
        }

        edgy (pivot_row != k) {
            flex (rizz j = k; j < dof_count; j = j + 1) {
                gigachad tmp = K[k * dof_count + j];
                K[k * dof_count + j] = K[pivot_row * dof_count + j];
                K[pivot_row * dof_count + j] = tmp;
            }
            gigachad tmp_f = F[k];
            F[k] = F[pivot_row];
            F[pivot_row] = tmp_f;
        }

        flex (rizz i = k + 1; i < dof_count; i = i + 1) {
            gigachad factor = K[i * dof_count + k] / K[k * dof_count + k];
            K[i * dof_count + k] = 0.0;

            flex (rizz j = k + 1; j < dof_count; j = j + 1) {
                K[i * dof_count + j] = K[i * dof_count + j] - factor * K[k * dof_count + j];
            }
            F[i] = F[i] - factor * F[k];
        }
    }

    🚽 Back substitution.
    rizz row = dof_count - 1;
    goon (row >= 0) {
        gigachad rhs = F[row];
        flex (rizz j = row + 1; j < dof_count; j = j + 1) {
            rhs = rhs - K[row * dof_count + j] * U[j];
        }
        U[row] = rhs / K[row * dof_count + row];
        row = row - 1;
    }

    🚽 Recover support reactions: R = K_original * U - F_original.
    flex (rizz i = 0; i < dof_count; i = i + 1) {
        gigachad sum = 0.0;
        flex (rizz j = 0; j < dof_count; j = j + 1) {
            sum = sum + K_original[i * dof_count + j] * U[j];
        }
        R[i] = sum - F_original[i];
    }

    yapping("GIGATRUSS v0.1");
    yapping("2D TRUSS STATIC ANALYSIS - finite rizz method");
    yapping("");
    yapping("NODE DISPLACEMENTS (m)");
    flex (rizz n = 0; n < node_count; n = n + 1) {
        yapping("Node %d: Ux=%0.9f Uy=%0.9f", n + 1, U[2 * n], U[2 * n + 1]);
    }

    yapping("");
    yapping("SUPPORT REACTIONS (N)");
    flex (rizz n = 0; n < node_count; n = n + 1) {
        edgy (fixed[2 * n] == W) {
            yapping("Node %d: Rx=%0.3f", n + 1, R[2 * n]);
        }
        edgy (fixed[2 * n + 1] == W) {
            yapping("Node %d: Ry=%0.3f", n + 1, R[2 * n + 1]);
        }
    }

    yapping("");
    yapping("MEMBER RESULTS");
    flex (rizz m = 0; m < member_count; m = m + 1) {
        rizz a = member_a[m];
        rizz b = member_b[m];

        gigachad dx = node_x[b] - node_x[a];
        gigachad dy = node_y[b] - node_y[a];
        gigachad length = gt_sqrt(dx * dx + dy * dy);
        gigachad c = dx / length;
        gigachad s = dy / length;

        gigachad extension = -c * U[2 * a] - s * U[2 * a + 1]
                           + c * U[2 * b] + s * U[2 * b + 1];
        gigachad axial_force = member_E[m] * member_A[m] / length * extension;
        gigachad stress = axial_force / member_A[m];

        edgy (axial_force >= 0.0) {
            yapping("Member %d (%d-%d): N=%0.3f N, stress=%0.6f MPa, TENSION",
                    m + 1, a + 1, b + 1, axial_force, stress / 1000000.0);
        } amogus {
            yapping("Member %d (%d-%d): N=%0.3f N, stress=%0.6f MPa, COMPRESSION",
                    m + 1, a + 1, b + 1, axial_force, stress / 1000000.0);
        }
    }

    yapping("");
    yapping("structure is bussin");
    bussin 0;
}
