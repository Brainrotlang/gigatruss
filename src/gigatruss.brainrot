gigachad gt_absx(gigachad aa) {
    edgy (aa < 0.0) {
        bussin -aa;
    }
    bussin aa;
}

gigachad gt_sqrt(gigachad aa) {
    rizz ab;
    gigachad ac;

    edgy (aa <= 0.0) {
        bussin 0.0;
    }

    ac = aa;
    edgy (ac < 1.0) {
        ac = 1.0;
    }

    flex (ab = 0; ab < 32; ab = ab + 1) {
        ac = 0.5 * (ac + aa / ac);
    }

    bussin ac;
}

skibidi main {
    🚽 Gigatruss v0.1: canonical 3-node triangular truss.
    🚽 Main-scope work identifiers are intentionally uniform-length to stay
    🚽 compatible with the current Brainrot hashmap implementation.

    rizz aa = 3;
    rizz ab = 3;
    rizz ac = 6;

    gigachad ad[3];
    gigachad ae[3];
    rizz af[3];
    rizz ag[3];
    gigachad ah[3];
    gigachad ai[3];

    gigachad aj[36];
    gigachad ak[36];
    gigachad al[6];
    gigachad am[6];
    gigachad an[6];
    gigachad ao[6];
    rizz ap[6];

    gigachad aq[16];
    rizz ar[4];

    rizz as;
    rizz at;
    rizz au;
    rizz av;
    rizz aw;
    rizz ax;
    rizz ay;
    rizz az;
    rizz ba;
    rizz bb;
    rizz bc;

    gigachad bd;
    gigachad be;
    gigachad bf;
    gigachad bg;
    gigachad bh;
    gigachad bi;
    gigachad bj;
    gigachad bk;
    gigachad bl;
    gigachad bm;
    gigachad bn;
    gigachad bo;
    gigachad bp;
    gigachad bq;
    gigachad br;
    gigachad bs;

    🚽 Geometry: node 1=(0,0), node 2=(4,0), node 3=(2,3).
    ad[0] = 0.0;
    ae[0] = 0.0;
    ad[1] = 4.0;
    ae[1] = 0.0;
    ad[2] = 2.0;
    ae[2] = 3.0;

    af[0] = 0;
    ag[0] = 1;
    af[1] = 0;
    ag[1] = 2;
    af[2] = 1;
    ag[2] = 2;

    flex (au = 0; au < ab; au = au + 1) {
        ah[au] = 200.0e9;
        ai[au] = 0.001;
    }

    🚽 Supports: node 1 fixed X/Y, node 2 fixed Y.
    flex (as = 0; as < ac; as = as + 1) {
        ap[as] = 0;
    }
    ap[0] = 1;
    ap[1] = 1;
    ap[3] = 1;

    🚽 External load: node 3, Fy = -10 kN.
    flex (as = 0; as < ac; as = as + 1) {
        al[as] = 0.0;
        an[as] = 0.0;
        ao[as] = 0.0;
    }
    al[5] = -10000.0;

    flex (as = 0; as < 36; as = as + 1) {
        aj[as] = 0.0;
        ak[as] = 0.0;
    }

    🚽 Assemble element stiffness matrices into K.
    flex (au = 0; au < ab; au = au + 1) {
        ay = af[au];
        az = ag[au];

        bd = ad[az] - ad[ay];
        be = ae[az] - ae[ay];
        bf = gt_sqrt(bd * bd + be * be);
        bg = bd / bf;
        bh = be / bf;
        bi = ah[au] * ai[au] / bf;

        aq[0] = bi * bg * bg;
        aq[1] = bi * bg * bh;
        aq[2] = -bi * bg * bg;
        aq[3] = -bi * bg * bh;
        aq[4] = bi * bg * bh;
        aq[5] = bi * bh * bh;
        aq[6] = -bi * bg * bh;
        aq[7] = -bi * bh * bh;
        aq[8] = -bi * bg * bg;
        aq[9] = -bi * bg * bh;
        aq[10] = bi * bg * bg;
        aq[11] = bi * bg * bh;
        aq[12] = -bi * bg * bh;
        aq[13] = -bi * bh * bh;
        aq[14] = bi * bg * bh;
        aq[15] = bi * bh * bh;

        ar[0] = 2 * ay;
        ar[1] = 2 * ay + 1;
        ar[2] = 2 * az;
        ar[3] = 2 * az + 1;

        flex (as = 0; as < 4; as = as + 1) {
            flex (at = 0; at < 4; at = at + 1) {
                ba = ar[as];
                bb = ar[at];
                aj[ba * ac + bb] = aj[ba * ac + bb] + aq[as * 4 + at];
            }
        }
    }

    flex (as = 0; as < 36; as = as + 1) {
        ak[as] = aj[as];
    }
    flex (as = 0; as < ac; as = as + 1) {
        am[as] = al[as];
    }

    🚽 Zero-displacement boundary conditions.
    flex (av = 0; av < ac; av = av + 1) {
        edgy (ap[av] == 1) {
            flex (at = 0; at < ac; at = at + 1) {
                aj[av * ac + at] = 0.0;
                aj[at * ac + av] = 0.0;
            }
            aj[av * ac + av] = 1.0;
            al[av] = 0.0;
        }
    }

    🚽 Gaussian elimination with partial pivoting.
    flex (aw = 0; aw < ac; aw = aw + 1) {
        bc = aw;
        bj = gt_absx(aj[aw * ac + aw]);

        flex (as = aw + 1; as < ac; as = as + 1) {
            bk = gt_absx(aj[as * ac + aw]);
            edgy (bk > bj) {
                bj = bk;
                bc = as;
            }
        }

        edgy (bj < 0.000000001) {
            baka("gigatruss: singular stiffness matrix");
            ragequit(2);
        }

        edgy (bc != aw) {
            flex (at = aw; at < ac; at = at + 1) {
                bl = aj[aw * ac + at];
                aj[aw * ac + at] = aj[bc * ac + at];
                aj[bc * ac + at] = bl;
            }
            bm = al[aw];
            al[aw] = al[bc];
            al[bc] = bm;
        }

        flex (as = aw + 1; as < ac; as = as + 1) {
            bn = aj[as * ac + aw] / aj[aw * ac + aw];
            aj[as * ac + aw] = 0.0;
            flex (at = aw + 1; at < ac; at = at + 1) {
                aj[as * ac + at] = aj[as * ac + at] - bn * aj[aw * ac + at];
            }
            al[as] = al[as] - bn * al[aw];
        }
    }

    🚽 Back substitution.
    ba = ac - 1;
    goon (ba >= 0) {
        bo = al[ba];
        flex (at = ba + 1; at < ac; at = at + 1) {
            bo = bo - aj[ba * ac + at] * an[at];
        }
        an[ba] = bo / aj[ba * ac + ba];
        ba = ba - 1;
    }

    🚽 Reactions: R = K_original * U - F_original.
    flex (as = 0; as < ac; as = as + 1) {
        bp = 0.0;
        flex (at = 0; at < ac; at = at + 1) {
            bp = bp + ak[as * ac + at] * an[at];
        }
        ao[as] = bp - am[as];
    }

    yapping("GIGATRUSS v0.1");
    yapping("2D TRUSS STATIC ANALYSIS - finite rizz method");
    yapping("");
    yapping("NODE DISPLACEMENTS (m)");
    flex (ax = 0; ax < aa; ax = ax + 1) {
        yapping("Node %d: Ux=%0.9f Uy=%0.9f", ax + 1, an[2 * ax], an[2 * ax + 1]);
    }

    yapping("");
    yapping("SUPPORT REACTIONS (N)");
    flex (ax = 0; ax < aa; ax = ax + 1) {
        edgy (ap[2 * ax] == 1) {
            yapping("Node %d: Rx=%0.3f", ax + 1, ao[2 * ax]);
        }
        edgy (ap[2 * ax + 1] == 1) {
            yapping("Node %d: Ry=%0.3f", ax + 1, ao[2 * ax + 1]);
        }
    }

    yapping("");
    yapping("MEMBER RESULTS");
    flex (au = 0; au < ab; au = au + 1) {
        ay = af[au];
        az = ag[au];
        bd = ad[az] - ad[ay];
        be = ae[az] - ae[ay];
        bf = gt_sqrt(bd * bd + be * be);
        bg = bd / bf;
        bh = be / bf;

        bq = -bg * an[2 * ay] - bh * an[2 * ay + 1]
           + bg * an[2 * az] + bh * an[2 * az + 1];
        br = ah[au] * ai[au] / bf * bq;
        bs = br / ai[au];

        edgy (br >= 0.0) {
            yapping("Member %d (%d-%d): N=%0.3f N, stress=%0.6f MPa, TENSION",
                    au + 1, ay + 1, az + 1, br, bs / 1000000.0);
        } amogus {
            yapping("Member %d (%d-%d): N=%0.3f N, stress=%0.6f MPa, COMPRESSION",
                    au + 1, ay + 1, az + 1, br, bs / 1000000.0);
        }
    }

    yapping("");
    yapping("structure is bussin");
    bussin 0;
}
